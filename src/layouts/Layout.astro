---
import '../styles/design.css';
import '../styles/base.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Clases de música clásica hindú.' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
