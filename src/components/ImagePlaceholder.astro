---
// Static stand-in for the design tool's <image-slot> web component.
// That component's drag/drop + persistence logic only works inside the
// Claude design-canvas host runtime, so it's dead weight in a shipped
// site — this renders the same placeholder look with zero JS, or a real
// <img> once you drop a photo into public/images and pass `src`.
interface Props {
  src?: string;
  alt?: string;
  placeholder?: string;
  /** CSS aspect-ratio, e.g. "4 / 5". Ignored when `fill` is true. */
  ratio?: string;
  /** Fill the positioned parent (100% width/height) instead of sizing by ratio — for full-bleed backgrounds. */
  fill?: boolean;
  class?: string;
}

const {
  src,
  alt = '',
  placeholder = 'Drop an image',
  ratio = '3 / 2',
  fill = false,
  class: className = '',
} = Astro.props;

const sizeStyle = fill ? 'width:100%;height:100%' : `width:100%;aspect-ratio:${ratio}`;
---

{src ? (
  <img src={src} alt={alt} class={className} style={sizeStyle} />
) : (
  <div class={`image-placeholder ${className}`} style={sizeStyle}>
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor"
      stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="3" width="18" height="18" rx="2" />
      <circle cx="8.5" cy="8.5" r="1.5" />
      <path d="m21 15-5-5L5 21" />
    </svg>
    <span>{placeholder}</span>
  </div>
)}

<style>
  img {
    display: block;
    object-fit: cover;
  }
  .image-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-align: center;
    padding: 12px;
    box-sizing: border-box;
    background: color-mix(in srgb, var(--color-text) 6%, transparent);
    border: 1.5px dashed color-mix(in srgb, var(--color-text) 30%, transparent);
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
    font-size: 13px;
    line-height: 1.3;
  }
</style>
